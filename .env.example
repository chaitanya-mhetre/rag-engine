# Copy to .env. Defaults run fully offline (fake providers, in-memory store).
RAG_STORE=memory                      # memory | postgres
RAG_DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:55433/rag
RAG_REDIS_URL=                        # e.g. redis://localhost:56380/0 (empty = inline ingestion, memory cache)
RAG_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Providers: hashing/fake are offline and free. Real providers need keys.
RAG_EMBEDDING_PROVIDER=hashing        # hashing | openai | gemini | local
RAG_EMBEDDING_MODEL=hashing-v1
RAG_EMBEDDING_DIM=384                 # must match the migration's vector(D)
RAG_LLM_PROVIDER=fake                 # fake | openai | gemini
RAG_LLM_MODEL=fake-extractive-v1
RAG_RERANKER=lexical                  # none | lexical | cross-encoder
RAG_OPENAI_API_KEY=
RAG_GEMINI_API_KEY=

# Retrieval
RAG_KEYWORD_RETRIEVER=bm25            # bm25 (hand-written) | pg_fts (Postgres full-text)
RAG_TOP_K=5
RAG_REFUSAL_THRESHOLD=0.2
